---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found" description="This page does not exist or has moved. Try the converters, the JSON, XML and YAML editors, the CSV viewer or the format guides instead." noindex>
  <div class="wrap">
    <div class="page-intro">
      <span class="eyebrow">404</span>
      <h1>This page could not be found</h1>
      <p class="lede">The address may be mistyped, or the page may have moved. These pages are a good place to start:</p>
      <ul class="tool-list">
        <li><a href="/"><strong>Home</strong><span>Convert between any two formats.</span></a></li>
        <li><a href="/converters"><strong>All converters</strong><span>CSV, JSON, YAML, XML, TOML and Excel.</span></a></li>
        <li><a href="/json-editor"><strong>JSON Editor</strong><span>Validate and format JSON.</span></a></li>
        <li><a href="/formats"><strong>Format guides</strong><span>How each format works.</span></a></li>
      </ul>
    </div>
  </div>
</Layout>
