---
import '../styles/global.css';
import ConsentDefaults from '../components/ConsentDefaults.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { site, moreTools } from '../lib/site.mjs';
import { EDITORS, GROUPS, GUIDES } from '../lib/tools.mjs';

interface Props {
  title?: string;
  description?: string;
  /** Main-menu entry to mark as current. */
  section?: string;
  /** Breadcrumbs after Home: [name, path?][]; the last one is the current page. */
  crumbs?: [string, string?][];
  noindex?: boolean;
  /** Extra JSON-LD objects for this page. */
  structured?: object[];
}

const { title = site.defaultTitle, description = site.defaultDescription, section = '', crumbs = [], noindex = false, structured: extra = [] } = Astro.props;
const suffix = ` | ${site.name}`;
const fullTitle = title.includes(site.name) || title.length + suffix.length > 60 ? title : title + suffix;
// Canonical URLs never end in a slash (except the home page, which is the bare domain plus "/").
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og-image.png', site.url).href;
const isHome = path === '/';

const structured: object[] = [];
if (isHome) {
  structured.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url + '/', description, inLanguage: 'en' });
}
if (crumbs.length) {
  structured.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [['Home', '/'], ...crumbs].map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: p ? new URL(p, site.url).href : canonical })),
  });
}
structured.push(...extra);

// [name, url, words hidden on narrow screens]
const nav: [string, string, string][] = [['Converters', '/converters', ''], ['JSON', '/json-editor', ' editor'], ['XML', '/xml-editor', ' editor'], ['YAML', '/yaml-editor', ' editor'], ['CSV', '/csv-viewer', ' viewer'], ['Formats', '/formats', '']];
const consentNeeded = Boolean(site.analyticsId);
const year = 2026;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <ConsentDefaults />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141d1a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Convert Data Formats: CSV, JSON, YAML, XML, TOML and Excel, converted in your browser" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;600&display=swap" />
    {structured.map(data => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
    {site.analyticsId && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}`}></script>
        <script is:inline define:vars={{ id: site.analyticsId }}>
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <img src="/favicon.svg" width="30" height="30" alt="" />
          <span>{site.name}</span>
        </a>
        <nav class="main-nav" aria-label="Main">
          {nav.map(([name, url, more]) => <a href={url} aria-current={section === name + more ? 'page' : undefined}>{name}{more && <span class="nav-long">{'\u00a0' + more.trim()}</span>}</a>)}
        </nav>
      </div>
    </header>
    <main id="main">
      {crumbs.length > 0 && (
        <nav class="breadcrumb wrap" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {crumbs.map(([name, p], i) => <li>{p && i < crumbs.length - 1 ? <a href={p}>{name}</a> : <span aria-current="page">{name}</span>}</li>)}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-about">
          <a href="/" class="brand"><img src="/favicon.svg" width="26" height="26" alt="" /><span>{site.name}</span></a>
          <p>Free tools for CSV, TSV, JSON, YAML, XML, TOML and Excel files. Everything runs in your browser: your files are never uploaded.</p>
          <small>© {year} {site.name}</small>
        </div>
        {GROUPS.map(group => (
          <nav aria-label={group.name}>
            <h2>{group.name}</h2>
            <ul>{group.pairs.map(pair => <li><a href={`/${pair.slug}`}>{pair.name}</a></li>)}</ul>
          </nav>
        ))}
        <nav aria-label="Editors and guides">
          <h2>Editors</h2>
          <ul>{EDITORS.map(tool => <li><a href={`/${tool.slug}`}>{tool.name}</a></li>)}</ul>
          <h2 style="margin-top:14px">Format guides</h2>
          <ul>{GUIDES.map(guide => <li><a href={`/formats/${guide.id}`}>{guide.name}</a></li>)}</ul>
        </nav>
        <nav aria-label="About this site">
          <h2>Site</h2>
          <ul>
            <li><a href="/converters">All converters</a></li>
            <li><a href="/formats">All format guides</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/privacy">Privacy</a></li>
            {consentNeeded && <li><button type="button" class="footer-link-button" data-cookie-settings>Cookie settings</button></li>}
          </ul>
          <h2 style="margin-top:14px">More free tools</h2>
          <ul>{moreTools.map(tool => <li><a href={tool.url}>{tool.name}</a>: {tool.about}</li>)}</ul>
        </nav>
      </div>
    </footer>
    {consentNeeded && <ConsentBanner />}
  </body>
</html>
